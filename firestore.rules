rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsBook(bookUid) {
      return request.auth != null
        && get(/databases/$(database)/documents/books/$(bookUid)).data.uid == request.auth.uid;
    }

    match /books/{document=**} {
      allow read,update,delete : if request.auth.uid == resource.data.uid;
      allow create : if request.auth != null;
    }

    match /notes/{noteId} {
      allow read, delete: if ownsBook(resource.data.bookUid);
      allow create: if ownsBook(request.resource.data.bookUid);
      allow update: if ownsBook(resource.data.bookUid)
        && request.resource.data.bookUid == resource.data.bookUid;
    }
  }
}
